rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Doorbell settings: the home doorbell service reads them without signing in;
    // only the owner can change them.
    match /bell/settings {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gavishori@gmail.com"
                   && request.auth.token.email_verified == true;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
